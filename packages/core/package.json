{
  "name": "uitest-sdk",
  "version": "0.11.0",
  "description": "HarmonyOS UI automation SDK: layout, screenshots, H.264/WebSocket casting, input, approvals and leases — the library other tools build on",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/growvv/uitest-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://growvv.github.io/uitest-sdk/",
  "keywords": [
    "harmonyos",
    "openharmony",
    "uitest",
    "automation",
    "scrcpy",
    "h264",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "types": "./dist/exports/commands.d.ts",
      "import": "./dist/exports/commands.js"
    },
    "./cast": {
      "types": "./dist/exports/cast.d.ts",
      "import": "./dist/exports/cast.js"
    },
    "./viewer": {
      "types": "./dist/exports/viewer.d.ts",
      "import": "./dist/exports/viewer.js"
    },
    "./govern": {
      "types": "./dist/exports/govern.d.ts",
      "import": "./dist/exports/govern.js"
    },
    "./drivers": {
      "types": "./dist/exports/drivers.d.ts",
      "import": "./dist/exports/drivers.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "docs/api.md",
    "examples/quickstart.mjs",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/cast/scrcpy.proto','dist/cast/scrcpy.proto')\"",
    "prepublishOnly": "npm run build && npm --prefix ../.. test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.0",
    "jpeg-js": "^0.4.4"
  }
}
