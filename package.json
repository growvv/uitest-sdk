{
  "name": "uitest-sdk",
  "version": "0.1.0",
  "description": "HarmonyOS uitest extension SDK for Node.js: UI automation, screenshots, H.264 casting and MP4 recording",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/growvv/uitest-sdk.git" },
  "homepage": "https://growvv.github.io/uitest-sdk/",
  "keywords": ["harmonyos", "openharmony", "uitest", "automation", "scrcpy", "h264"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/cast/scrcpy.proto','dist/cast/scrcpy.proto')\"",
    "test": "vitest run test/unit",
    "test:device": "vitest run test/device",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
