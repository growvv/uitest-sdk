{
  "name": "uitest-sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude '**/device/**'",
    "test:device": "vitest run test/device",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.7.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
